# ============================================================
# 亚瑟 RE-SS-01 固件 seed 配置（骨架版）
#
# 用法：cp 到源码根目录为 .config → make defconfig
# 说明：`make defconfig` 会补齐依赖并**静默忽略未知符号**，
#       所以这里写错包名不会炸构建，只会「没装上」。
#       首次成功构建后，用 scripts/save-config.sh 把真实 .config 抓回来，
#       再以真实配置反向收敛本文件（把注释掉的项逐个打开验证）。
# ============================================================

# ---------- 目标平台与设备 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# 内核：默认 6.12（分支 KERNEL_PATCHVER）；6.18 由 workflow 追加 CONFIG_TESTING_KERNEL=y
CONFIG_KERNEL_KALLSYMS=n
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n

# ---------- 满血 NSS（分支 DEFAULT_PACKAGES 已带，这里显式锁死防回归）----------
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y

# ---------- Wi-Fi / 板级 ----------
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=y

# ---------- 中文 LuCI（ImmortalWrt 默认已中文，显式钉住语言包）----------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- 存储支持（8G eMMC 硬改 + 网络共享的基础）----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y

# ---------- 诊断与运维（稳定好用 = 出问题时能自证）----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ---------- 明确不要的东西（减小体积与攻击面）----------
CONFIG_PACKAGE_luci-app-adblock=n
CONFIG_PACKAGE_udpxy=n
CONFIG_PACKAGE_minidlna=n

# ============================================================
# 后期以「装包」方式上线，不编译进固件的部分（占位，别开）
# ============================================================
# CONFIG_PACKAGE_luci-app-openclash=y      # 代理：Mihomo/OpenClash 内核与插件后期装
# CONFIG_PACKAGE_luci-app-passwall=y       # 代理备选
# CONFIG_PACKAGE_luci-app-mosdns=y         # DNS 备选（与 OxiDNS 二选一，只跑一个）
# CONFIG_PACKAGE_luci-app-samba4=y         # 网络共享备选（ksmbd 路线为主）
CONFIG_CCACHE=y
