#!/bin/sh
# ==============================================================================
# 99-nikki-rps
# Nikki 虚拟网卡多核软中断自动均衡热插拔脚本
# 解决痛点：TUN/TPROXY 虚拟网卡在网络启动后动态生成，会绕过开机 rc.local 的
#           静态网卡遍历，导致软中断挤占 CPU 0 单核。本脚本在网卡建立时动态绑定多核。
# ==============================================================================

if [ "$DEVICENAME" = "nikki" ] || [ "$INTERFACE" = "nikki" ] || [ -d /sys/class/net/nikki ]; then
    if [ -e /sys/class/net/nikki/queues/rx-0/rps_cpus ]; then
        echo "e" > /sys/class/net/nikki/queues/rx-0/rps_cpus
        logger -t nikki-rps "Bound nikki rx-0 RPS to CPU cores 1-3 (mask e)"
    fi
fi
