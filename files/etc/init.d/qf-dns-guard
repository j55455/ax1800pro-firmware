#!/bin/sh /etc/rc.common
# ==============================================================================
# qf-dns-guard —— 承载 DNS 单入口开机自检（真正的逻辑在 /usr/sbin/qf-dns-guard）
#
# 一次性服务：不设 respawn，跑完即退出，避免每小时重复打扰。
# 由 /etc/uci-defaults/zz-oxidns 首次开机 enable。
# ==============================================================================

START=99

USE_PROCD=1

start_service() {
	[ -x /usr/sbin/qf-dns-guard ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/qf-dns-guard
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
