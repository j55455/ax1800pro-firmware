#!/bin/sh
# ==============================================================================
# 99-qf-defaults
# 京东云亚瑟 (AX1800 Pro / RE-SS-01) 首次开机基础系统与网络出厂初始化脚本
# 原则：不内嵌 MosDNS 与 Nikki 自定义业务配置，保证出厂即开即连，DNS 畅通无锁死
# ==============================================================================

# 1. 激活 4 核心网卡软中断均衡 (RPS)
uci -q set network.globals.packet_steering='1'

# 2. 固化 WAN 口 MTU 为 1492，贴合上级光猫 PPPoE 路径消除分片
uci -q set network.wan.mtu='1492'

# 3. 关闭 Linux 软件通用流表（交由高通 NSS ECM 硬件流表接管，避免两套流表互抢冲突）
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'

# 3.1 启用 FullCone NAT1（fw4 原生 + kmod-nft-fullcone，游戏联机 / P2P / PT 直达 NAT1）
uci -q set firewall.@defaults[0].fullcone='1'

# 4. 确保 WAN 口开启 TCP MSS 自动规约 (MSS Clamping)
uci -q set firewall.@zone[1].mtu_fix='1'

# 5. 固化无线配置（沿用用户旧固件命名：主机名/SSID = qf，密码 = 8765432101）
#    5GHz(radio0) = psk2+ccmp / 信道36 / HE80 / 启用
#    2.4GHz(radio1) = psk2+ccmp / 信道1 / HE20 / 启用（旧固件默认禁用，导致 IoT 设备连不上，改为开启）
#    国家码 AU（同为旧固件取值，兼顾覆盖与散热）
# 等待底层无线配置与驱动就绪（最多 30 秒，彻底解决 ath11k 冷启动慢导致的无线假死）
i=0
while [ $i -lt 30 ]; do
	[ -s /etc/config/wireless ] && break
	sleep 1
	i=$((i + 1))
done
[ -s /etc/config/wireless ] || wifi config 2>/dev/null || true

for d in $(uci -q show wireless | grep '=wifi-device' | cut -d'.' -f2 | cut -d'=' -f1); do
	band=$(uci -q get wireless."${d}".band)
	uci -q set wireless."${d}".country='AU'
	case "$band" in
		5g)
			uci -q set wireless."${d}".channel='36'
			uci -q set wireless."${d}".htmode='HE80'
			uci -q set wireless."${d}".cell_density='0'
			uci -q set wireless."${d}".disabled='0'
			;;
		2g)
			uci -q set wireless."${d}".channel='1'
			uci -q set wireless."${d}".htmode='HE20'
			uci -q set wireless."${d}".disabled='0'
			;;
		*)
			uci -q set wireless."${d}".disabled='0'
			;;
	esac
done

for w in $(uci -q show wireless | grep '=wifi-iface' | cut -d'.' -f2 | cut -d'=' -f1); do
	dev=$(uci -q get wireless."${w}".device)
	band=$(uci -q get wireless."${dev}".band)
	uci -q set wireless."${w}".ssid='qf'
	uci -q set wireless."${w}".key='8765432101'
	if [ "$band" = "5g" ]; then
		uci -q set wireless."${w}".encryption='psk2+ccmp'
		uci -q set wireless."${w}".disabled='0'
		uci -q set wireless."${w}".dtim_period='1'
		uci -q set wireless."${w}".ocv='0'
		uci -q set wireless."${w}".disassoc_low_ack='0'
		uci -q set wireless."${w}".max_inactivity='3600'
	elif [ "$band" = "2g" ]; then
		uci -q set wireless."${w}".encryption='psk2+ccmp'
		uci -q set wireless."${w}".disabled='0'
	else
		# 频段探测异常时兜底为可用状态，杜绝把 WiFi 全部禁用导致失联
		uci -q set wireless."${w}".encryption='psk2+ccmp'
		uci -q set wireless."${w}".disabled='0'
	fi
done

# 6. 固化系统主机名与时区软链接，并设置默认主题为 kucat
[ -e /usr/share/zoneinfo/Asia/Shanghai ] && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
uci -q set system.@system[0].hostname='qf'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q commit system

# 固化 LuCI 默认主题为 kucat (sirpdboy/luci-theme-kucat)，并强制独占单主题
# 彻底清空其他主题注册项，仅保留 KuCat，根除多主题下拉与快速切换引发的前端缓存错乱 Bug
if [ -d /www/luci-static/kucat ]; then
	uci -q delete luci.themes 2>/dev/null || true
	# 删除后必须显式重建 section（stock 为 `config internal 'themes'`），
	# 直接在已删除的 section 上写选项会留下无类型的空配置
	uci -q set luci.themes='internal'
	uci -q set luci.themes.KuCat='/luci-static/kucat'
	uci -q set luci.main.mediaurlbase='/luci-static/kucat'
	uci -q commit luci
	# 清理 LuCI 模板索引与静态缓存，保证主题切换即时生效
	rm -rf /tmp/luci-indexcache /tmp/luci-modulecache /tmp/luci-*
fi

# 7. CPU 调频：底层固化 schedutil 动态节能调度（脱离 Web 插件依赖，原生底层调频）
#    额定上限 1.2GHz 保证满血突发；空闲时自动降至 300MHz 降温节能
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
	[ -w "$gov" ] && echo 'schedutil' > "$gov" 2>/dev/null || true
done
if [ -f /etc/config/cpufreq ]; then
	uci -q set cpufreq.cpufreq.governor0='schedutil'
	uci -q set cpufreq.cpufreq.minfreq0='300000'
	uci -q set cpufreq.cpufreq.maxfreq0='1200000'
	uci -q commit cpufreq
fi

# 7.1 移除 QCA pbuf 出厂配置里的 scaling_governor 硬锁
#     （防止开机第 86 级的 qca-nss-pbuf 覆写 CPU 调频为 performance）
if [ -f /etc/config/pbuf ]; then
	uci -q delete pbuf.opt.scaling_governor
	uci -q commit pbuf
fi

# 8. 固化 NSS 3 队列多核中断绑定，释放 CPU 0 专供系统与代理
if [ -f /etc/config/nss ]; then
	uci -q set nss.general.enable_rps='1'
	uci -q commit nss
fi

# 8.1 补齐 /etc/config/ecm 缺失的 general 段
if [ -f /etc/config/ecm ] && ! uci -q get ecm.general >/dev/null 2>&1; then
	printf "\nconfig ecm 'general'\n\toption disable_offloads '0'\n\toption disable_flow_control '0'\n\toption disable_interrupt_moderation '0'\n\toption disable_gro '0'\n\toption disable_gro_list '1'\n" >> /etc/config/ecm
	uci -q commit ecm
fi

# 9. Dnsmasq 基础标准配置（保持默认解析，不强制转入未配置的 5335，保障开机网络畅通）
uci -q set dhcp.@dnsmasq[0].ednspacket_max='1232'
uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'
uci -q commit dhcp

# 10. IPv6 默认彻底关闭（用户明确不需要 IPv6；同时杜绝 IPv6 分流/泄漏/环路隐患）
#     内核层由 sysctl disable_ipv6=1 兜底，这里再关掉 RA/DHCPv6/NDP 与相关 UCI 残留。
uci -q delete network.globals.ula_prefix 2>/dev/null || true
uci -q delete network.lan.ip6assign 2>/dev/null || true
uci -q delete network.lan.ip6ifaceid 2>/dev/null || true
uci -q delete network.wan6 2>/dev/null || true
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ndp='disabled' 2>/dev/null || true
uci -q delete dhcp.lan.ra_flags 2>/dev/null || true
uci -q set firewall.@zone[1].masq6='0'
uci -q commit dhcp

# 提交网络与防火墙配置
uci -q commit network
uci -q commit firewall
uci -q commit wireless
wifi up 2>/dev/null || true

# 11. 内存安全网：配置并启用 zram 压缩交换（OOM 兜底，吸取 NatserverWrt 解决亚瑟爆内存思路）
if [ -x /etc/init.d/zram ]; then
	uci -q set system.@system[0].zram_size_mb='384'
	uci -q set system.@system[0].zram_comp_algo='lz4'
	uci -q commit system
	/etc/init.d/zram enable 2>/dev/null || true
	/etc/init.d/zram start 2>/dev/null || true
fi

# 12. 启用 QWRT 同款 NSS 满血中断绑核调优（nss_queue1/2/3 -> CPU1/2/3，释放 CPU0）
[ -x /etc/init.d/qf-nss-perf ] && /etc/init.d/qf-nss-perf enable 2>/dev/null || true

# 12.1 启用 VIKINGYFY 同款 EDMA 中断绑核与硬件 GRO 前期加速服务 (START=94)
[ -x /etc/init.d/smp_affinity ] && {
	/etc/init.d/smp_affinity enable 2>/dev/null || true
	/etc/init.d/smp_affinity start 2>/dev/null || true
}

# 12.2 NSS 协处理器超频（1497.6MHz）默认不启用：优先“稳”而不是峰值算力。
#      需要时手动 `/etc/init.d/nss_freq start`（脚本与 /etc/config/nss_freq 仍在固件内）
[ -x /etc/init.d/nss_freq ] && /etc/init.d/nss_freq disable 2>/dev/null || true

# 13. 启用轻量温控守护（QWRT thermald 分级降温思路：高温限频 + 低温恢复）
[ -x /etc/init.d/qf-thermal ] && /etc/init.d/qf-thermal enable 2>/dev/null || true

# 14. 无用服务裁剪：关闭非核心、非用户需求的服务（存在才关），减负载降温
for svc in zerotier tailscale tailscaled easytier openvpn openvpn_client adblock smartdns pppoe-relay mwan3 vpn-policy-routing; do
	if [ -x "/etc/init.d/$svc" ]; then
		/etc/init.d/"$svc" disable 2>/dev/null || true
		/etc/init.d/"$svc" stop 2>/dev/null || true
	fi
done

# 15. TTYD 网页终端免密直连（/bin/login -f root 已登录 root shell）
if [ -f /etc/config/ttyd ]; then
	uci -q set ttyd.@ttyd[0].command='/bin/login -f root'
	uci -q commit ttyd
fi
uci -q set dropbear.@dropbear[0].PasswordAuth='on'
uci -q set dropbear.@dropbear[0].RootPasswordAuth='on'
uci -q commit dropbear
# 16. root 密码统一为 password：与现网 QWRT 一致，换固件后原有 ssh/sshpass 习惯与脚本无需改动
#     （仅 LAN 内可达；如需改密请登录 LuCI 或 passwd 命令）
#     失败时绝不降级为空密码：只留痕，保留镜像默认状态
if printf 'root:password\n' | chpasswd 2>/dev/null; then
	logger -t qf-defaults "root password set"
else
	logger -t qf-defaults "WARNING: chpasswd failed, root password left as image default (NOT cleared)"
fi

# 17. 软件源纯化（去重 + 剔除失效分类源，消除 apk 报错与警告）
[ -x /usr/bin/qf-fix-apk-repos ] && /usr/bin/qf-fix-apk-repos >/dev/null 2>&1 || true

exit 0
