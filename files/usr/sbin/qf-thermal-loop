#!/bin/sh
# ==============================================================================
# qf-thermal-loop —— 轻量用户态温控（逆向自 QWRT /usr/sbin/thermald 的分级降温思路）
# 原理：读取所有 thermal_zone 温度，取最高有效值 M：
#   M >= 85C：把 CPU scaling_max_freq 下调到 800MHz，并开启 NSS 时钟自动降频
#   M <= 75C：恢复到开机原始 max（滞回 10C，防止临界抖动反复切换）
# 安全：全部路径存在性判断；温度仅接受 30000..125000 的合法值；仅在状态切换时写入；
#       任何失败都静默跳过，绝不影响转发与启动。
# ==============================================================================

STATE_FILE=/tmp/.qf_thermal_state
HOT=85000
COOL=75000
THROTTLE_MAX=800000

# 记录开机原始 max（恢复用）
ORIG_MAX=""
for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
	[ -e "$c" ] || continue
	ORIG_MAX=$(cat "$c" 2>/dev/null)
	break
done
[ -n "$ORIG_MAX" ] || exit 0

set_max() {
	for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
		[ -e "$c" ] && echo "$1" > "$c" 2>/dev/null
	done
}

echo cool > "$STATE_FILE" 2>/dev/null

while :; do
	# 取最高有效温度
	t=0
	for z in /sys/class/thermal/thermal_zone*/temp; do
		[ -e "$z" ] || continue
		v=$(cat "$z" 2>/dev/null)
		case "$v" in ''|*[!0-9]*) continue ;; esac
		if [ "$v" -ge 30000 ] && [ "$v" -le 125000 ] && [ "$v" -gt "$t" ]; then
			t=$v
		fi
	done

	state=$(cat "$STATE_FILE" 2>/dev/null)
	if [ "$t" -ge "$HOT" ] && [ "$state" != "hot" ]; then
		echo "hot" > "$STATE_FILE" 2>/dev/null
		set_max "$THROTTLE_MAX"
		# 联动 NSS 时钟自动降频（存在才写）
		[ -e /proc/sys/dev/nss/clock/auto_scale ] && echo 1 > /proc/sys/dev/nss/clock/auto_scale 2>/dev/null
		logger -t qf-thermal "hot ${t}mC -> cap CPU ${THROTTLE_MAX}kHz"
	elif [ "$t" -gt 0 ] && [ "$t" -le "$COOL" ] && [ "$state" = "hot" ]; then
		echo "cool" > "$STATE_FILE" 2>/dev/null
		set_max "$ORIG_MAX"
		[ -e /proc/sys/dev/nss/clock/auto_scale ] && echo 0 > /proc/sys/dev/nss/clock/auto_scale 2>/dev/null
		logger -t qf-thermal "cool ${t}mC -> restore CPU ${ORIG_MAX}kHz"
	fi

	sleep 15
done
