# ==============================================================================
# 京东云亚瑟 (AX1800 Pro / RE-SS-01) 核心组件与插件配置模板
# 架构原则：极简纯净、极高信噪比、海外丝滑分流、轻量存储扩展、无冗余负担
# ==============================================================================

# LuCI 界面与中文语言包
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lua-runtime=y

# 主题配置：仅保留 Kucat 猫咪主题（含配置面板），杜绝多主题并存与快速切换导致的前端缓存错乱
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-kucat-config=y
# 彻底剔除 Argon 主题及其配置面板（避免多主题下拉与快速切换 Bug）
# CONFIG_PACKAGE_luci-theme-argon is not set
CONFIG_PACKAGE_luci-theme-argon=n
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_PACKAGE_luci-app-argon-config=n
# 彻底剔除 Aurora 主题及其配置面板
# CONFIG_PACKAGE_luci-theme-aurora is not set
CONFIG_PACKAGE_luci-theme-aurora=n
# CONFIG_PACKAGE_luci-app-aurora-config is not set
CONFIG_PACKAGE_luci-app-aurora-config=n

# 核心分流与代理一：MosDNS v5
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_v2ray-geodata-updater=y
CONFIG_PACKAGE_geo2txt=y

# DNS 二选一：SmartDNS（来自标准 feeds/packages，实机已验证可与 MosDNS 共存，运行期只启用一个）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# 核心分流与代理二：Nikki (Mihomo 核心，TPROXY/TUN 满血转发)
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_luci-i18n-nikki-zh_Hans=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y

# 轻量存储扩展：Samba4 + OpenList2 + 常用文件系统驱动栈
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_usbutils=y

# 系统运维与硬件监控管理插件
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_luci-app-ttyd=y
# CONFIG_PACKAGE_luci-app-cpufreq is not set
CONFIG_PACKAGE_luci-app-cpufreq=n
# CONFIG_PACKAGE_cpufreq is not set
CONFIG_PACKAGE_cpufreq=n
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-wolultra=y

# 包管理器前端（对齐实机 luci-app-package-manager）
CONFIG_PACKAGE_luci-app-package-manager=y

# 网卡诊断工具（smp_affinity 的 GRO 硬件卸载依赖 ethtool，必须打包）
CONFIG_PACKAGE_ethtool=y

# UPnP：miniupnpd-nftables 与 firewall4/nftables 原生兼容（P2P/游戏联机端口自动映射）
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y

# 网络诊断、证书链与核心协议栈支持
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_bind-nslookup=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# DNS 前端：dnsmasq-full（支持 nftset/ipset，对标 NatserverWrt 企业级选择；与 MosDNS 配合更佳）
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq=n

# 内存/OOM 安全网：zram 压缩交换（吸取 NatserverWrt 解决亚瑟爆内存问题的思路）
# 配合 sysctl 的 vm.swappiness，在突发内存压力下以压缩页顶替真实换页，避免 OOM 杀进程
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# 代理三选一（Nikki / daede / open-box，运行期只启用其中一个，互不冲突）
# daede：原生 BTF eBPF（直接复用内核 CONFIG_DEBUG_INFO_BTF，无需 vmlinux-btf 包）
# 源：kenzok8/openwrt-daede（含 dae + daed + luci-app-daede + vmlinux-btf，自带 ARM 补丁）
CONFIG_PACKAGE_daed=y
CONFIG_DAED_USE_KERNEL_BTF=y
# CONFIG_DAED_USE_VMLINUX_BTF is not set
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-daede_daed=y
# CONFIG_PACKAGE_luci-app-daede_dae is not set
# 不使用独立 daed 前端与 dae 内核（统一走 daede 一体包）
CONFIG_PACKAGE_luci-app-daed=n
CONFIG_PACKAGE_dae=n

# 融入 VIKINGYFY / qca-all-in-one 内核 eBPF / XDP 全套驱动与通信模块
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# TCP BBR 拥塞控制
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_DEFAULT_tcp_bbr=y
# CONFIG_DEFAULT_tcp_cubic is not set

# firewall4 (nftables) 与透明代理底层支持（纯血 nftables，零 iptables 杂质）
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-queue=y

# ============ 彻底剔除 iptables 旧栈（实测零外部依赖，纯血 nftables） ============
# 依据：实机 apk --rdepends 反向依赖核查
#   iptables-nft / iptables-mod-ipopt 的 "required by" 均为空（顶层孤岛）
#   firewall4 / nikki / mihomo 全程纯 nftables+TPROXY，不依赖任何 iptables
#   整条链自闭环：iptables-nft -> xtables-nft -> libiptext*/kmod-nft-compat -> libxtables/kmod-nf-ipt
CONFIG_PACKAGE_kmod-nft-compat=n
CONFIG_PACKAGE_kmod-ipt-core=n
CONFIG_PACKAGE_kmod-ipt-ipopt=n
CONFIG_PACKAGE_iptables-mod-ipopt=n
CONFIG_PACKAGE_iptables-nft=n
CONFIG_PACKAGE_xtables-nft=n
CONFIG_PACKAGE_libxtables=n
CONFIG_PACKAGE_libiptext=n
CONFIG_PACKAGE_libiptext6=n
CONFIG_PACKAGE_libiptext-nft=n
CONFIG_PACKAGE_kmod-nf-ipt=n
# 注意：kmod-iptunnel / kmod-iptunnel4 / kmod-iptunnel6 是 IP 隧道驱动（sit/gre/vxlan/nss-tunipip6 依赖），
#       名字带 ipt 但与 iptables 无关，严禁剔除。

# 编译优化与系统调试参数
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ================= 严格断舍离组件（显式彻底禁用） =================
# 1. 彻底剔除 luci-app-ecm 界面（NSS 硬件加速由底层内核驱动静默全速接管，无前端包袱）
# CONFIG_PACKAGE_luci-app-ecm is not set
CONFIG_PACKAGE_luci-app-ecm=n

# 2. 彻底剔除 Tailscale（用户不使用，且其虚拟网卡和路由规则会干扰透明代理）
# CONFIG_PACKAGE_luci-app-tailscale is not set
CONFIG_PACKAGE_luci-app-tailscale=n
# CONFIG_PACKAGE_tailscale is not set
CONFIG_PACKAGE_tailscale=n

# 3. 彻底剔除 EasyTier
# CONFIG_PACKAGE_luci-app-easytier is not set
CONFIG_PACKAGE_luci-app-easytier=n
# CONFIG_PACKAGE_easytier is not set
CONFIG_PACKAGE_easytier=n

# 4. 彻底剔除 PushBot
# CONFIG_PACKAGE_luci-app-pushbot is not set
CONFIG_PACKAGE_luci-app-pushbot=n

# 5. 彻底剔除 Diskman（重型磁盘管理工坊，容易引起 udev 与分区锁定冲突）
# CONFIG_PACKAGE_luci-app-diskman is not set
CONFIG_PACKAGE_luci-app-diskman=n

# 6. 彻底剔除 SQM（在 NSS 硬件加速平台开启会导致 NAT 击穿 CPU，大幅劣化吞吐）
# CONFIG_PACKAGE_luci-app-sqm is not set
CONFIG_PACKAGE_luci-app-sqm=n
# CONFIG_PACKAGE_sqm-scripts-nss is not set
CONFIG_PACKAGE_sqm-scripts-nss=n

# 7. 剔除冗余或危险应用
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
# CONFIG_PACKAGE_luci-app-wol is not set
CONFIG_PACKAGE_luci-app-wol=n
