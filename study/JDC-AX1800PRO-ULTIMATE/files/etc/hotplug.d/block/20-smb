#!/bin/sh
# ==============================================================================
# 20-smb
# 移动存储设备热插拔自动挂载 Samba4 共享（安全隔离版）
# 严格限制：仅对外接 USB 磁盘 (sd*/hd*/vd*) 生效，严禁泄露内部 eMMC 分区 (mmcblk*)
# ==============================================================================

. /lib/functions.sh
. /lib/functions/service.sh

config_file="/etc/config/samba4"
[ -f "$config_file" ] || config_file="/etc/config/samba"
smb_service="samba4"
[ -x "/etc/init.d/samba4" ] || smb_service="samba"

global=0

wait_for_init() {
	for i in $(seq 30); do
		[ -e /tmp/procd.done ] && return
		sleep 1
	done
}

smb_handle() {
	config_get path "$1" path
	[ "$path" = "$2" ] && global=1
}

device=$(basename "$DEVPATH")

case "$ACTION" in
	add)
		case "$device" in
			sd*|hd*|vd*) ;;
			*) return ;;
		esac

		path="/dev/$device"
		wait_for_init

		cat /proc/mounts | while read -r j; do
			str=${j%% *}
			if [ "$str" = "$path" ]; then
				strr=${j#* }
				target=${strr%% *}
				global=0
				config_load "$smb_service"
				config_foreach smb_handle sambashare "$target"
				name=${target#*/mnt/}

				if [ "$global" -eq 0 ]; then
					printf "\nconfig sambashare\n\toption auto '1'\n\toption name '%s'\n\toption path '%s'\n\toption read_only 'no'\n\toption guest_ok 'yes'\n\toption create_mask '0666'\n\toption dir_mask '0777'\n\toption device '%s'\n" "$name" "$target" "$device" >> "$config_file"
					/etc/init.d/"$smb_service" reload >/dev/null 2>&1
					return
				fi
			fi
		done
		;;
	remove)
		i=0
		while true; do
			dev=$(uci -q get "${smb_service}".@sambashare["$i"].device)
			[ -z "$dev" ] && break
			if [ "$dev" = "$device" ]; then
				uci -q delete "${smb_service}".@sambashare["$i"]
				uci -q commit "$smb_service"
				/etc/init.d/"$smb_service" reload >/dev/null 2>&1
				return
			fi
			i=$((i + 1))
		done
		;;
esac
