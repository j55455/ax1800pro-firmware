#!/bin/sh /etc/rc.common
# ==============================================================================
# qf-thermal —— 轻量温控守护（procd 托管 qf-thermal-loop）
# ==============================================================================

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/qf-thermal-loop
	# 异常退出时自动拉起（5s 内最多 5 次）
	procd_set_param respawn 300 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	:
}
