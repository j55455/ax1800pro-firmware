#!/bin/sh
# ==============================================================================
# install-openbox —— Open-Box 一键安装器（封装官方 liandu2024/Open-Box 安装脚本）
#
# 用法：
#   install-openbox                 # 直连 GitHub 安装（面板默认端口 3036）
#   install-openbox --mirror        # 通过镜像加速（自动探测内置镜像列表）
#   install-openbox --mirror <前缀> # 指定镜像前缀，例如 --mirror ghproxy.example.com
#   install-openbox --port 3036     # 指定面板端口
#
# 设计说明：
#   - 本脚本只负责“下载并执行官方安装器”，Open-Box 本体（sing-box 内核 + Node 运行时 +
#     GeoSite/GeoIP 数据，完整包约 106MB）在安装时联网下载，**不预装进固件 rootfs**，
#     避免固件体积膨胀。
#   - Open-Box 与 Nikki / daede 同为代理方案，**运行期请只启用其中一个**。
#   - 首次打开面板（http://<路由器IP>:3036）会强制走“设置密码”流程。
#   - 依赖：curl 或 wget（固件已内置 curl / wget-ssl）。
# ==============================================================================
set -eu

RAW_URL="https://raw.githubusercontent.com/liandu2024/Open-Box/main/scripts/install.sh"
MIRROR_URL="https://ghfast.top/https://raw.githubusercontent.com/liandu2024/Open-Box/main/scripts/install.sh"
TMP="${OPENBOX_INSTALLER:-/tmp/openbox-install.sh}"

fetch() {
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL "$1" -o "$TMP"
	elif command -v wget >/dev/null 2>&1; then
		wget -qO "$TMP" "$1"
	else
		echo "[install-openbox] 缺少 curl/wget，无法下载安装器" >&2
		exit 1
	fi
}

echo "[install-openbox] 正在下载 Open-Box 官方安装器..."
if ! fetch "$RAW_URL"; then
	echo "[install-openbox] 直连 GitHub 失败，尝试通过镜像重试..."
	if ! fetch "$MIRROR_URL"; then
		echo "[install-openbox] 镜像下载仍失败，请检查网络。" >&2
		echo "  可稍后手动执行：curl -fsSL $RAW_URL | sh -s -- --mirror" >&2
		exit 1
	fi
fi

echo "[install-openbox] 开始安装 Open-Box（面板默认端口 3036）..."
sh "$TMP" "$@"
